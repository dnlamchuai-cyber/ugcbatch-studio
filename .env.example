# UGCBatch Studio environment template. Copy to .env and fill in; never commit real keys.

# Public web / VPS deploy: 1 = ignore client apiKey/baseUrl, block private/loopback/link-local URLs, disable probe routes.
WEB_MODE=
# Desktop/dev only: 1 = allow local/LAN provider endpoints (Ollama, LM Studio); ignored when WEB_MODE=1.
ALLOW_PRIVATE_BASEURL=

# Server-managed LLM (Gemini OpenAI-compatible endpoint); used for all LLM calls in web mode.
GEMINI_API_KEY=

# System media-provider credentials used in web mode. Empty BASE_URL = the provider's default endpoint.
# Atlas Cloud API key.
SYSTEM_ATLAS_CLOUD_API_KEY=
# Atlas Cloud base URL override.
SYSTEM_ATLAS_CLOUD_BASE_URL=
# fal.ai API key.
SYSTEM_FAL_AI_API_KEY=
# fal.ai base URL override.
SYSTEM_FAL_AI_BASE_URL=
# Volcengine (Ark) API key.
SYSTEM_VOLCENGINE_API_KEY=
# Volcengine (Ark) base URL override.
SYSTEM_VOLCENGINE_BASE_URL=
# Alibaba (DashScope) API key.
SYSTEM_ALIBABA_API_KEY=
# Alibaba (DashScope) base URL override.
SYSTEM_ALIBABA_BASE_URL=
# SiliconFlow API key.
SYSTEM_SILICONFLOW_API_KEY=
# SiliconFlow base URL override.
SYSTEM_SILICONFLOW_BASE_URL=
# Replicate API token.
SYSTEM_REPLICATE_API_KEY=
# Replicate base URL override.
SYSTEM_REPLICATE_BASE_URL=
# OpenAI (or OpenAI-compatible) API key.
SYSTEM_OPENAI_API_KEY=
# OpenAI base URL override.
SYSTEM_OPENAI_BASE_URL=

# System TTS used in web mode: provider id (openai | atlas | minimax | falai).
SYSTEM_TTS_PROVIDER=
# System TTS base URL (empty = the provider's default endpoint).
SYSTEM_TTS_BASE_URL=
# System TTS API key.
SYSTEM_TTS_API_KEY=
